#!/bin/sh
# main 과 버전 태그 (v*) 가 아닌 ref 의 push 를 막고, 올리기 전에 게이트를 다시 돈다.
# 커밋 메시지의 검증 줄은 주장이고 이 훅이 확인이다. 규칙 정본은 skills/specs/operation/sourceControl.md.

ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main) ;;
    refs/tags/v*)
      # 태그 삭제 (zero sha) 는 통과. 새 태그는 가리키는 커밋의 __version__ 과 이름이 같아야 한다.
      # v0.0.3 과 v0.0.5 가 커밋이 만들어지지 않은 채 옛 커밋에 찍혀 나간 실수를 기계로 막는다.
      if [ "$local_sha" != "$ZERO" ]; then
        want="${remote_ref#refs/tags/v}"
        have="$(git show "$local_sha^{commit}:src/hanlint/__init__.py" 2>/dev/null | sed -n 's/^__version__ = "\(.*\)"$/\1/p')"
        if [ "$want" != "$have" ]; then
          echo "blocked: 태그 v$want 가 가리키는 커밋의 __version__ 은 '$have' 다. 커밋이 만들어졌는지 본다" >&2
          exit 1
        fi
      fi
      ;;
    "") ;;
    *)
      echo "blocked: main 과 버전 태그 (v*) 만 push 한다: $remote_ref" >&2
      exit 1
      ;;
  esac
done

repo_root="$(git rev-parse --show-toplevel)"
if [ ! -d "$repo_root/tests" ]; then
  exit 0
fi

python_bin="$repo_root/.venv/Scripts/python.exe"
if [ ! -x "$python_bin" ]; then
  python_bin="$(command -v python || command -v python3)"
fi
if [ -z "$python_bin" ]; then
  echo "blocked: 게이트를 돌릴 python 이 없다" >&2
  exit 1
fi

# CI (ci.yml) 와 같은 순서로 ruff 를 먼저 돈다. 2026-09-17 v0.0.11 이 E501 하나로 세 워크플로에서 막힌 것이 이유다.
for ruff_args in "check" "format --check"; do
  # shellcheck disable=SC2086
  if ! "$python_bin" -X utf8 -B -m ruff $ruff_args "$repo_root/src" "$repo_root/tests" "$repo_root/hooks" "$repo_root/scripts" >/dev/null 2>&1; then
    echo "blocked: ruff $ruff_args 가 red 다. 고치고 다시 push 한다" >&2
    # shellcheck disable=SC2086
    "$python_bin" -X utf8 -B -m ruff $ruff_args "$repo_root/src" "$repo_root/tests" "$repo_root/hooks" "$repo_root/scripts" 2>&1 | tail -20 >&2
    exit 1
  fi
done

if ! "$python_bin" -X utf8 -B -m pytest -q "$repo_root/tests" >/dev/null 2>&1; then
  echo "blocked: pytest 가 red 다. 고치고 다시 push 한다" >&2
  "$python_bin" -X utf8 -B -m pytest -q "$repo_root/tests" 2>&1 | tail -20 >&2
  exit 1
fi

# 파생 자료 (data/profiles.json, data/blueprints.json) 는 기준 말뭉치에서 다시 세어 글자 단위로 견준다. 말뭉치는 이 기계에만
# 있으므로 없으면 건너뛴다고 말하고 통과시킨다. 2026-09-02 에 profiles.json 이 4일 동안 코드보다 낡은 채 배포된 것이 이유다.
corpus_root="$(HANLINT_REPO="$repo_root" "$python_bin" -X utf8 -B -c "import os, sys; sys.path.insert(0, os.environ['HANLINT_REPO']); from scripts.fetch.corpus import corpusRoot, readCatalogue; print(corpusRoot(readCatalogue()))")"
if [ -d "$corpus_root" ]; then
  for derive in scripts/derive/profiles.py scripts/derive/blueprints.py; do
    if ! "$python_bin" -X utf8 -B "$repo_root/$derive" --check >/dev/null 2>&1; then
      echo "blocked: $derive --check 가 red 다. 파생 자료를 다시 만들어 같은 커밋에 넣는다" >&2
      exit 1
    fi
  done
else
  echo "말뭉치가 $corpus_root 에 없어 파생 자료 검사를 건너뛴다" >&2
fi
