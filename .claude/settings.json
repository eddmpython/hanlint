{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"${CLAUDE_PROJECT_DIR:-.}/hooks/writeGate.py\" pre"
          }
        ]
      }
    ]
  }
}
