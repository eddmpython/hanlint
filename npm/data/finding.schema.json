{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanlint.dev/schemas/finding.schema.json",
  "title": "hanlint Finding",
  "description": "A deterministic prose issue with its location, reason, and optional local repair data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule", "line", "severity", "scope", "at", "quote", "why"],
  "properties": {
    "rule": { "type": "string", "minLength": 1 },
    "line": { "type": "integer", "minimum": 1 },
    "severity": { "enum": ["error", "notice"] },
    "scope": { "enum": ["sentence", "paragraph", "section", "document"] },
    "at": { "type": "integer", "minimum": -1 },
    "quote": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "fix": { "type": "string", "minLength": 1 },
    "fragment": { "type": ["string", "null"] },
    "replacement": { "type": "string" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "why"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "dependentRequired": {
    "fragment": ["replacement"],
    "replacement": ["fragment"]
  }
}
