{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanlint.dev/schemas/panelTrialSet.schema.json",
  "title": "hanlint writing arena panel trial set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "studyId",
    "candidateStrategyId",
    "provenance",
    "trials",
    "claimBoundary",
    "trialSetSha256"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "hanlint.panelTrialSet" },
    "studyId": { "type": "string", "minLength": 1 },
    "candidateStrategyId": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "license", "containsExternalReferenceText", "qualityLabels"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "containsExternalReferenceText": { "type": "boolean" },
        "qualityLabels": { "const": false }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "writingTrial.schema.json" }
    },
    "claimBoundary": { "type": "string", "minLength": 1 },
    "trialSetSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
